NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/financial_flow?retryWrites=true&w=majority

# Security secrets
SESSION_SECRET=your_super_secret_session_key_minimum_32_chars
MFA_ENCRYPTION_KEY=your_64_hex_character_mfa_encryption_key

# Email Delivery (Gmail / SMTP / Nodemailer)
EMAIL_HOST=gmail
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Financial Flow <your_email@gmail.com>"

# Python ML Microservice
ML_SERVICE_URL=http://127.0.0.1:8000

# Grounded AI Engine (Google Gemini & OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
